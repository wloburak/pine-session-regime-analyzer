//@version=6
indicator("Session Regime Analyzer", overlay=true)

// ================= INPUTS =================
session_str = input.string("0930-1600", "Session Hours")
session_tz  = input.string("America/New_York", "Session Timezone")

or_minutes = input.int(15, "Opening Range Minutes")

ema_fast_len = input.int(20, "EMA Fast")
ema_slow_len = input.int(50, "EMA Slow")
ema_tf       = input.timeframe("5", "Pullback EMA TF")

atr_len = input.int(14, "ATR Length")

vol_sma_len         = input.int(20, "Volume SMA")
vol_ratio_threshold = input.float(1.5, "Volume Surge")

use_htf     = input.bool(true, "HTF Bias")
htf_ema_len = input.int(20, "HTF EMA")

// ================= SESSION =================
in_session  = not na(time(timeframe.period, session_str, session_tz))
new_session = in_session and not in_session[1]

// ================= OR =================
var float or_high = na
var float or_low  = na
var int bar_count = 0
var bool or_locked = false

if new_session
    or_high := na
    or_low := na
    bar_count := 0
    or_locked := false

if in_session and not or_locked
    bar_count += 1
    or_high := na(or_high) ? high : math.max(or_high, high)
    or_low  := na(or_low)  ? low  : math.min(or_low, low)

bars_needed = math.round(or_minutes / timeframe.multiplier)

if in_session and not or_locked and bar_count >= bars_needed
    or_locked := true

price_above_or  = close > or_high
price_below_or  = close < or_low
price_inside_or = not price_above_or and not price_below_or

// ================= VWAP =================
vwap = ta.vwap
weekly_vwap = ta.vwap(hlc3, timeframe.change("W"))

var float sum_w = 0.0
var float sum_wx = 0.0
var float sum_wx2 = 0.0

if timeframe.change("W")
    sum_w := 0
    sum_wx := 0
    sum_wx2 := 0

tp = hlc3
w = volume

sum_w += w
sum_wx += w * tp
sum_wx2 += w * tp * tp

vw_mean = sum_w > 0 ? sum_wx / sum_w : na
variance = sum_w > 0 ? (sum_wx2 / sum_w) - (vw_mean * vw_mean) : na
dev = math.sqrt(variance)

upper_band2 = weekly_vwap + dev * 2
lower_band2 = weekly_vwap - dev * 2

plot(weekly_vwap, color=color.orange, linewidth=2)
plot(upper_band2, color=color.red)
plot(lower_band2, color=color.green)

// ================= VWAP REACTION =================
vwap_react_long = low <= lower_band2 and close > lower_band2
vwap_react_short = high >= upper_band2 and close < upper_band2

// ================= EMA =================
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

isUptrend = ema_fast > ema_slow
isDowntrend = ema_fast < ema_slow

eightLine = request.security(syminfo.tickerid, ema_tf, ta.ema(close, 8))

// ================= HTF =================
daily_ema = request.security(syminfo.tickerid, "D", ta.ema(close, htf_ema_len))
daily_close = request.security(syminfo.tickerid, "D", close)

htf_bull = daily_close > daily_ema
htf_bear = daily_close < daily_ema

// ================= VOLUME =================
vol_sma = ta.sma(volume, vol_sma_len)
vol_ratio = vol_sma > 0 ? volume / vol_sma : 1.0
vol_surge = vol_ratio >= vol_ratio_threshold

// ================= SCORE =================
score = 0
score := score + (close > vwap ? 20 : -20)
score := score + (price_above_or ? 20 : price_below_or ? -20 : 0)
score := score + (isUptrend ? 20 : isDowntrend ? -20 : 0)
score := score + (vol_surge ? 10 : 0)
score := score + (htf_bull ? 10 : htf_bear ? -10 : 0)

smoothed_score = ta.ema(score, 5)

// ================= REGIME =================
is_trend = math.abs(smoothed_score) > 60
is_range = math.abs(smoothed_score) < 40
in_dead_zone = math.abs(smoothed_score) < 15

// ================= CHECKLIST =================
sweep_high = high > high[1]
sweep_low  = low < low[1]

bull_engulf = close > high[1]
bear_engulf = close < low[1]

check_sweep = sweep_high or sweep_low
check_reaction = bull_engulf or bear_engulf
check_trend = is_trend or is_range
check_volume = vol_surge
check_vwap = is_range and (vwap_react_long or vwap_react_short)
check_sweep_5m   = request.security(syminfo.tickerid, "5", check_sweep, lookahead=barmerge.lookahead_off)
check_react_5m   = request.security(syminfo.tickerid, "5", check_reaction, lookahead=barmerge.lookahead_off)
check_trend_5m   = request.security(syminfo.tickerid, "5", check_trend, lookahead=barmerge.lookahead_off)
check_volume_5m  = request.security(syminfo.tickerid, "5", check_volume, lookahead=barmerge.lookahead_off)
check_vwap_5m    = request.security(syminfo.tickerid, "5", check_vwap, lookahead=barmerge.lookahead_off)

check_score = (check_sweep_5m ? 1 : 0) + (check_react_5m ? 1 : 0) + (check_trend_5m ? 1 : 0) + (check_volume_5m ? 1 : 0) + (check_vwap_5m ? 1 : 0)

valid_setup = check_score >= 3

// ================= OR LINES =================
var line or_high_line = na
var line or_low_line  = na

// Delete old lines on new session
if new_session
    if not na(or_high_line)
        line.delete(or_high_line)
    if not na(or_low_line)
        line.delete(or_low_line)

// Draw lines when OR locks
if or_locked and not or_locked[1]
    or_high_line := line.new(bar_index, or_high, bar_index + 1, or_high, extend=extend.right, color=color.green, width=2)
    or_low_line  := line.new(bar_index, or_low,  bar_index + 1, or_low,  extend=extend.right, color=color.red,   width=2)

// ================= ENTRIES =================
range_long = is_range and not in_dead_zone and low < or_low and close > or_low and valid_setup
range_short = is_range and not in_dead_zone and high > or_high and close < or_high and valid_setup

plotshape(range_long, location=location.belowbar, color=color.green, text="RL")
plotshape(range_short, location=location.abovebar, color=color.red, text="RS")

// ================= CHECKLIST PANEL =================
var table checklist = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    headerBg = color.new(color.gray, 85)
    rowBg1   = color.new(color.black, 85)
    rowBg2   = color.new(color.black, 75)

    align = text.align_left

    // Header
    table.cell(checklist, 0, 0, "Checklist", text_color=color.white, bgcolor=headerBg, text_halign=align)
    table.cell(checklist, 1, 0, "Status",   text_color=color.white, bgcolor=headerBg, text_halign=align)

    // Sweep
    table.cell(checklist, 0, 1, "Sweep", bgcolor=rowBg1, text_halign=align)
    table.cell(checklist, 1, 1, check_sweep_5m ? "✔" : "✖", text_color=check_sweep ? color.green : color.red, bgcolor=rowBg1)

    // Reaction
    table.cell(checklist, 0, 2, "Reaction", bgcolor=rowBg2, text_halign=align)
    table.cell(checklist, 1, 2, check_react_5m ? "✔" : "✖", text_color=check_reaction ? color.green : color.red, bgcolor=rowBg2)

    // Trend
    table.cell(checklist, 0, 3, "Trend", bgcolor=rowBg1, text_halign=align)
    table.cell(checklist, 1, 3, check_trend_5m ? "✔" : "✖", text_color=check_trend ? color.green : color.red, bgcolor=rowBg1)

    // Volume
    table.cell(checklist, 0, 4, "Volume", bgcolor=rowBg2, text_halign=align)
    table.cell(checklist, 1, 4, check_volume_5m ? "✔" : "✖", text_color=check_volume ? color.green : color.red, bgcolor=rowBg2)

    // VWAP
    table.cell(checklist, 0, 5, "VWAP React", bgcolor=rowBg1, text_halign=align)
    table.cell(checklist, 1, 5, check_vwap_5m ? "✔" : "✖", text_color=check_vwap ? color.green : color.red, bgcolor=rowBg1)
